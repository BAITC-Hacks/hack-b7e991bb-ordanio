# Скопируйте в .env и заполните. Без ключа проект работает полностью, кроме LLM-аналитика и чата с агентом.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Модель сводки дня (текст в журнале и на кнопке «прогноз на день»); чат использует OPENAI_MODEL
OPENAI_MODEL_NOTE=gpt-5.4
# 1 — не обращаться к Open-Meteo, использовать только погодный кэш data/weather_cache. Настройка не отключает OpenAI и ресурсы оформления
WEATHER_OFFLINE=0
# 1 (по умолчанию) — основной режим погоды, упреждение 48/72 ч; 0 — сравнительный режим 24/48
# WEATHER_STRICT=1
# Адрес фонового ролика заставки; пусто — спокойный фон без видео
# HERO_VIDEO_URL=
